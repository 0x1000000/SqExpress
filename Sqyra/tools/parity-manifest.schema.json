{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sqyra parity manifest",
  "type": "object",
  "required": ["schemaVersion", "sourceContract", "subsystems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceContract": { "type": "string" },
    "subsystems": {
      "type": "object",
      "required": [
        "ast",
        "traversal",
        "descriptors",
        "parser",
        "exporters",
        "builders",
        "documentation"
      ]
    }
  }
}
