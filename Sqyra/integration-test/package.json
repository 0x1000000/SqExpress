{
  "name": "sqyra-integration-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.5"
  },
  "scripts": {
    "inventory": "node tools/inventory.mjs",
    "refresh:sqyra": "node tools/refresh-sqyra.mjs",
    "audit": "node tools/audit.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:int": "tsx src/run.ts",
    "verify": "npm --prefix .. run build && npm run refresh:sqyra && npm run typecheck && npm test && node tools/audit.mjs --require-complete && npm run test:int"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "msnodesqlv8": "5.4.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.4",
    "pg": "^8.16.3",
    "sqyra": "file:.."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^9.1.7",
    "@types/node": "^20.19.13",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vitest": "^1.6.1"
  }
}
